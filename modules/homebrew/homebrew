###############################################################################
# Module: homebrew
# Description:
# 	Defines ...
# 	nextline
###############################################################################

#
# Template for new module creation.
# Substitute the new module name for 'homebrew'
# %s/homebrew/newname/gc

__homebrew_dependencies=( 'mbe' )
__homebrew_aliases=( 'git' )

_homebrew_load ()
{
	DEBUG echo "_homebrew_load: enter"
	local module="homebrew"

	# Locate brew and cache its install prefix once here rather than in
	# _setpath, which _mbe_buildpath calls on every path rebuild -- avoids
	# forking "brew" (shellenv + --prefix) on every module (de)activation.
	HOMEBREW_BREWBIN="$(_homebrew_findbrew)"
	if [ -n "${HOMEBREW_BREWBIN}" ]; then
		HOMEBREW_PREFIX="$("${HOMEBREW_BREWBIN}" --prefix)"
	fi

	DEBUG echo "_homebrew_load: leave"
}

_homebrew_unload ()
{
	local als
	for als in "${__homebrew_aliases[@]}"; do
		unalias "${als}" 2>/dev/null
	done
	return 0
}

_homebrew_findbrew ()
{
	# Homebrew's install prefix varies by platform: Apple Silicon Macs use
	# /opt/homebrew, Intel Macs use /usr/local, Linux uses
	# /home/linuxbrew/.linuxbrew. Rather than hardcoding one, look for the
	# "brew" binary in each known location (and fall back to PATH) so this
	# module works unmodified across machines.
	local candidate
	for candidate in "/opt/homebrew/bin/brew" "/usr/local/bin/brew" "/home/linuxbrew/.linuxbrew/bin/brew"; do
		if [ -x "${candidate}" ]; then
			echo "${candidate}"
			return 0
		fi
	done
	command -v brew 2>/dev/null
}

_homebrew_setpath ()
{
	if [ -n "${HOMEBREW_BREWBIN}" ]; then
		# "brew shellenv" is Homebrew's own supported way to wire up
		# PATH/MANPATH/INFOPATH -- avoids hardcoding install paths ourselves
		# and avoids setting JAVA_HOME, which sdkman now owns exclusively
		# (see the sdkman module) rather than /usr/libexec/java_home.
		# HOMEBREW_BREWBIN/HOMEBREW_PREFIX are resolved once in _homebrew_load,
		# not re-derived here, since _setpath runs on every path rebuild.
		eval "$("${HOMEBREW_BREWBIN}" shellenv)"

		if [ -d "${HOMEBREW_PREFIX}/opt/libpq/bin" ]; then
			export PATH="${HOMEBREW_PREFIX}/opt/libpq/bin:${PATH}"
		fi
		if [ -f "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]; then
			. "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
		fi
		if [ -f "${HOMEBREW_PREFIX}/bin/hub" ]; then
			alias git=hub
		fi
	fi
}

_homebrew_usage ()
{
	echo -ne ""

}

_homebrew_complete()
{
	COMPREPLY=( )
	return 0
}
