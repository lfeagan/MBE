###############################################################################
# Module: msyteclaude
# Description:
# 	Environment for the mSyte Claude Code plugins (msyte-devops-claude-plugin,
# 	msyte-service-claude-plugin, etc.) -- currently just exports
# 	SOURCE_CODE_ROOT, which those plugins' hooks and scripts read to locate
# 	the msyte-development checkout.
###############################################################################

__msyteclaude_dependencies=( 'mbe' )

_msyteclaude_load ()
{
	DEBUG echo "_msyteclaude_load: enter"
	_mbe_activateModules "${__msyteclaude_dependencies[@]}"
	local module="msyteclaude"

	# Load preferences
	source "${MODULES_DIR}/${module}/${module}.conf"

	DEBUG echo "_msyteclaude_load: leave"
}

_msyteclaude_unload ()
{
	return 0
}

_msyteclaude_setpath ()
{
	return 0
}

_msyteclaude_info ()
{
	echo "Environment for the mSyte Claude Code plugins (msyte-devops, msyte-service, ...)"
	echo "SOURCE_CODE_ROOT=${SOURCE_CODE_ROOT}"
}

_msyteclaude_env()
{
	echo "SOURCE_CODE_ROOT=${SOURCE_CODE_ROOT}"
}

_msyteclaude_complete()
{
	COMPREPLY=( )

	if [ "$COMP_CWORD" -eq 2 ]; then
		local funcs="env"
		mapfile -t COMPREPLY < <(compgen -W "${funcs}" -- "${cur}")
		return 0
	fi

	COMPREPLY=( )
	return 0
}
