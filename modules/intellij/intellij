# App launchers via "open -a <name>", which resolves by app display name
# rather than a hardcoded path -- works regardless of whether an app is
# installed directly under ~/Applications or /Applications, via JetBrains
# Toolbox, or with a version suffix in its .app folder name (e.g. "IntelliJ
# IDEA Ultimate 2023.1.7.app"). Only errors (via "open"'s own message) if you
# actually try to launch an app that isn't installed -- unlike a hardcoded
# alias, it doesn't silently no-op for every app just because one directory
# doesn't exist.
android-studio () { open -a "Android Studio" "$@"; }
clion () { open -a "CLion" "$@"; }
datagrip () { open -a "DataGrip" "$@"; }
goland () { open -a "GoLand" "$@"; }
intellij () { open -a "IntelliJ IDEA" "$@"; }
phpstorm () { open -a "PhpStorm" "$@"; }
pycharm () { open -a "PyCharm" "$@"; }
toolbox () { open -a "JetBrains Toolbox" "$@"; }
webstorm () { open -a "WebStorm" "$@"; }

_intellij_info ()
{
	echo "Provides JetBrains IDE launchers (intellij, pycharm, webstorm, ...), \"idea <repo>\" to open a matched git repo directly, and \"proj <repo>\" to cd into it"
}

_intellij_findrepo ()
{
	# Shared by "idea" and "proj": resolves <repo-name> to a single git repo
	# path by substring match, searched across INTELLIJ_IDEA_SEARCH_ROOTS up to
	# INTELLIJ_IDEA_SEARCH_DEPTH levels deep. On a unique match, echoes the
	# path to stdout. On multiple matches, prompts (on stderr/tty) and echoes
	# the chosen path to stdout.
	# All diagnostic/prompt output goes to stderr so callers can safely capture
	# the resolved path via command substitution. $2 is the caller's command
	# name, used only in the usage message.
	local query="$1" cmd="${2:-idea}"
	if [ -z "${query}" ]; then
		echo "Usage: ${cmd} <repo-name>" >&2
		return 1
	fi

	local matches=( )
	local root dir
	for root in "${INTELLIJ_IDEA_SEARCH_ROOTS[@]}"; do
		[ -d "${root}" ] || continue
		while IFS= read -r dir; do
			[ -e "${dir}/.git" ] && matches+=("${dir}")
		done < <(find "${root}" -mindepth 1 -maxdepth "${INTELLIJ_IDEA_SEARCH_DEPTH:-4}" -type d -iname "*${query}*" 2>/dev/null | sort)
	done

	if [ "${#matches[@]}" -eq 0 ]; then
		echo "No git repo matching '${query}' found." >&2
		return 1
	elif [ "${#matches[@]}" -eq 1 ]; then
		echo "${matches[0]}"
	else
		echo "Multiple matches -- pick one:" >&2
		local i
		for i in "${!matches[@]}"; do
			echo "  $(( i + 1 ))) ${matches[$i]}" >&2
		done
		local choice
		printf "Enter number: " >&2
		read -r choice </dev/tty
		if [[ "${choice}" =~ ^[0-9]+$ ]] && [ "${choice}" -ge 1 ] && [ "${choice}" -le "${#matches[@]}" ]; then
			echo "${matches[$(( choice - 1 ))]}"
		else
			echo "Invalid selection." >&2
			return 1
		fi
	fi
}

_intellij_idea ()
{
	# Opens a repo by name in IntelliJ IDEA. Usage: mbe intellij idea <repo-name>
	local match
	match="$(_intellij_findrepo "$1" "mbe intellij idea")" || return 1
	echo "Opening ${match}"
	open -na "${INTELLIJ_IDEA_APP}" --args "${match}"
}

idea () { _intellij_idea "$@"; }

_intellij_proj ()
{
	# cd's into a repo by name. Usage: proj <repo-name>
	local match
	match="$(_intellij_findrepo "$1" "proj")" || return 1
	cd "${match}" || return 1
}

proj () { _intellij_proj "$@"; }

_intellij_complete()
{
	COMPREPLY=( )
	return 0
}
