# App launchers via "open -a <name>", which resolves by app display name
# rather than a hardcoded path -- works regardless of whether an app is
# installed directly under ~/Applications or /Applications, via JetBrains
# Toolbox, or with a version suffix in its .app folder name (e.g. "IntelliJ
# IDEA Ultimate 2023.1.7.app"). Only errors (via "open"'s own message) if you
# actually try to launch an app that isn't installed -- unlike a hardcoded
# alias, it doesn't silently no-op for every app just because one directory
# doesn't exist.
android-studio () { open -a "Android Studio" "$@"; }
clion () { open -a "CLion" "$@"; }
datagrip () { open -a "DataGrip" "$@"; }
goland () { open -a "GoLand" "$@"; }
intellij () { open -a "IntelliJ IDEA" "$@"; }
phpstorm () { open -a "PhpStorm" "$@"; }
pycharm () { open -a "PyCharm" "$@"; }
toolbox () { open -a "JetBrains Toolbox" "$@"; }
webstorm () { open -a "WebStorm" "$@"; }

