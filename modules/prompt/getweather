# Prints the last cached weather string, refreshing the cache in the
# background if it is missing or older than PROMPT_WEATHER_REFRESH_SECONDS.
# Always returns immediately -- never blocks the prompt on the network.

url="${PROMPT_WEATHER_URL:-wttr.in/?format=3}"
maxage="${PROMPT_WEATHER_REFRESH_SECONDS:-3600}"
cachedir="${MBE_DIR:-${HOME}/.mbe}/cache"
cachefile="${cachedir}/weather"

mkdir -p "${cachedir}" 2>/dev/null

age=$(( maxage + 1 ))
if [ -f "${cachefile}" ]; then
	mtime=$(stat -f %m "${cachefile}" 2>/dev/null || stat -c %Y "${cachefile}" 2>/dev/null)
	if [ -n "${mtime}" ]; then
		age=$(( $(date +%s) - mtime ))
	fi
fi

if [ "${age}" -ge "${maxage}" ]; then
	( curl -s --max-time 5 "${url}" > "${cachefile}.tmp" 2>/dev/null && mv "${cachefile}.tmp" "${cachefile}" ) &
	disown 2>/dev/null
fi

[ -f "${cachefile}" ] && cat "${cachefile}"
exit 0
