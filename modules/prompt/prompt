__prompt_dependencies=( 'mbe' 'colors' )

_prompt_info ()
{
	echo "Configures PS1 (colors, titlebar, weather) based on light/dark terminal background detection"
}

_prompt_load ()
{
	# Load module dependencies
	_mbe_activateModules "${__prompt_dependencies[@]}"
	# Set module name
	local module="prompt"
	# Load preferences
	source "${MODULES_DIR}/${module}/${module}.conf"
	if [ "${PROMPT_AUTODETECT_ENABLE}" == "1" ]; then
		_prompt_detectbackground
	fi
	_prompt_configure
	return 0
}

_prompt_unload ()
{
	return 0
}

_prompt_setpath ()
{
	local module="prompt"
	return 0
}

_prompt_command ()
{
	local module="prompt"
	# XTerm supports a titlebar
	local titlebartext
	local has_titlebar=0
	case $TERM in
		xterm* | vt100 )
			has_titlebar=1
			titlebartext="${PROMPT_TITLEBARTEXT}"
			if [ "${PROMPT_WEATHER_ENABLE}" -eq "1" ] && [ -x "${PROMPT_WEATHER_COMMAND}" ]; then
				local weather
				weather="$( "${PROMPT_WEATHER_COMMAND}" )"
				titlebartext="${titlebartext} ${weather}"
			fi
			;;
	esac

	if [ "${has_titlebar}" -eq 1 ]; then
		# Escape sequence to start writing to the terminal window titlebar
		local titlebar_start='\[\e]0;'
		# Escape sequence to finish writing to the terminal window titlebar
		local titlebar_end=" \a"

		# Always (re-)send the titlebar sequence, even with empty text, since
		# terminal titles are sticky -- omitting the sequence would leave
		# whatever text (e.g. weather) was sent on a previous call stuck.
		PS1="${titlebar_start}${titlebartext}${titlebar_end}${PROMPT_BASE}"
	else
		PS1="${PROMPT_BASE}"
	fi
		
	# Conditionally, prepend TABCOLOR (only for use with Konsole) to PS1
	#TABCOLOR='\e[28;COLORt (COLOR: 0-16,777,215)'
	PROMPT_TABCOLOR='\e[28;8t'
	if [[ "${PROMPT_TABCOLOR_ENABLE}" == 1 ]]; then
		PS1="${PROMPT_TABCOLOR}${PS1}"
	fi
}

_prompt_detectbackground ()
{
	local module="prompt"
	local is_light=""

	if [ -n "${COLORFGBG}" ]; then
		# COLORFGBG is "foreground;background" as ANSI palette indices (0-15).
		# Set by iTerm2, Ghostty, rxvt/urxvt and others. Not set by Terminal.app.
		local bgindex="${COLORFGBG##*;}"
		case "${bgindex}" in
			0|1|2|3|4|5|6|8) is_light=0;;
			*) is_light=1;;
		esac
	elif [ "${TERM_PROGRAM}" == "Apple_Terminal" ]; then
		# Terminal.app sets neither COLORFGBG nor answers OSC 11; ask it directly.
		local rgb
		rgb="$(osascript -e 'tell application "Terminal" to get background color of selected tab of front window' 2>/dev/null)"
		if [ -n "${rgb}" ]; then
			local parts r g b
			IFS=',' read -ra parts <<< "${rgb}"
			r="${parts[0]//[[:space:]]/}"
			g="${parts[1]//[[:space:]]/}"
			b="${parts[2]//[[:space:]]/}"
			if [ -n "${r}" ] && [ -n "${g}" ] && [ -n "${b}" ]; then
				if [ $(( (r + g + b) / 3 )) -ge 32768 ]; then
					is_light=1
				else
					is_light=0
				fi
			fi
		fi
	fi

	if [ -n "${is_light}" ]; then
		if [ "${is_light}" -eq 1 ]; then
			PROMPT_INPUT_COLOR="black"
		else
			PROMPT_INPUT_COLOR="white"
		fi
	fi
	# If detection failed (unknown terminal, tmux/screen eating env vars,
	# osascript denied/errored), fall through and keep the .conf default.
}

_prompt_configure ()
{
	local module="prompt"
	local username_color
	if [ "$(${IDPROG_USERID})" -eq 0 ]; then
		username_color="${PROMPT_ROOTUSER_COLOR}"
	else
		username_color="${PROMPT_NONROOTUSER_COLOR}"
	fi

	# Change the shell prompt to my liking
	if [ -z "$LOGIN_SHELL" ]; then
		case "${PROMPT_INPUT_COLOR}" in
			"white" ) PROMPT_BASE="${username_color}${PROMPT_BASE_WHITE}";;
			"black" ) PROMPT_BASE="${username_color}${PROMPT_BASE_BLACK}";;
			* ) PROMPT_BASE="${PROMPT_BASE_OTHER}"
		esac
	fi

	PS1=${PROMPT_BASE}
}

_prompt_complete()
{
	local opts
	COMPREPLY=( )
	opts="swcolor weatheron weatheroff"

	case "${prev}" in
		swcolor|weatheron|weatheroff)
			COMPREPLY=( )
			return 0
			;;
		esac

	mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
	return 0
}

_prompt_swcolor ()
{
	case "${PROMPT_INPUT_COLOR}" in
		"white" ) PROMPT_INPUT_COLOR="black";;
		"black" ) PROMPT_INPUT_COLOR="white";;
		* ) PROMPT_INPUT_COLOR="__colors_black";;
	esac
	_prompt_configure
}

_prompt_weatheron ()
{
	export PROMPT_WEATHER_ENABLE="1"
}

_prompt_weatheroff ()
{
	export PROMPT_WEATHER_ENABLE="0"
}
