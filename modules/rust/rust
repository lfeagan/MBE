###############################################################################
# Module: rust
# Description:
# 	Adds the Cargo bin directory (where "cargo install" and rustup place
# 	binaries) into PATH. Honors $CARGO_HOME, defaulting to $HOME/.cargo.
###############################################################################

__rust_dependencies=( 'mbe' )

_rust_load ()
{
	DEBUG echo "_rust_load: enter"
	local module="rust"

	DEBUG echo "_rust_load: leave"
}

_rust_unload ()
{
	return 0
}

_rust_setpath ()
{
	local bindir="${CARGO_HOME:-${HOME}/.cargo}/bin"
	if [ -d "${bindir}" ]; then
		PATH="${bindir}:${PATH}"
	fi
}

_rust_info ()
{
	echo -e "adds \$CARGO_HOME/bin (default \$HOME/.cargo/bin) to \$PATH"
}

_rust_complete()
{
	COMPREPLY=( )
	return 0
}
