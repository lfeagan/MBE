############################################################
# Module: mbe
# Description:
#  Contains the core MBE tools used for managing the bash
#  environment, including modules, debugging, and logging.
############################################################

# MODULES_ACTIVE (indexed array) preserves activation order, which
# _mbe_buildpath relies on to build PATH/LD_LIBRARY_PATH/MANPATH/INCLUDE with
# later-activated modules taking precedence over earlier ones.
# MODULES_ACTIVE_SET (associative array) mirrors the same membership as an
# O(1) lookup table for _mbe_isModuleActive, since bash associative arrays
# do not guarantee iteration order and so cannot replace MODULES_ACTIVE
# outright. Guarded like ORIG_PATH below so re-sourcing this file (e.g. via
# `resource`) does not wipe out already-active modules.
if ! declare -p MODULES_ACTIVE_SET >/dev/null 2>&1; then
	declare -gA MODULES_ACTIVE_SET
fi

# MBE_MODULE_FUNCS (associative array, module name -> space-separated function
# names) is derived automatically by _mbe_activateModules diffing `declare -F`
# before/after sourcing+loading a module, instead of each module hand-
# maintaining a __<name>_functions array (which drifted from reality in
# numerous modules -- see CLAUDE.md). _mbe_deactivateModules reads this to
# unset exactly the functions a module actually defined.
# _MBE_ACTIVATE_DEPTH / _MBE_CLAIMED_FUNCS support this: _mbe_activateModules
# recurses (a module's own _load activates its dependencies), so a naive
# before/after diff around the outer call would also capture every function
# a nested dependency defined. Each recursive frame claims its own functions
# (removing them from _MBE_CLAIMED_FUNCS's complement) before returning, so
# an outer frame's diff never includes what an inner frame already claimed.
# The depth counter resets the claimed-set only when unwinding back to the
# top of one _mbe_activateModules call tree, not on every nested call.
if ! declare -p MBE_MODULE_FUNCS >/dev/null 2>&1; then
	declare -gA MBE_MODULE_FUNCS
fi
if ! declare -p _MBE_ACTIVATE_DEPTH >/dev/null 2>&1; then
	declare -gi _MBE_ACTIVATE_DEPTH=0
fi
if ! declare -p _MBE_CLAIMED_FUNCS >/dev/null 2>&1; then
	declare -gA _MBE_CLAIMED_FUNCS
fi

# MBE_MODULE_VARS (associative array, module name -> space-separated variable
# names) is the same idea as MBE_MODULE_FUNCS above, but for environment
# variables a module's _load/_setpath sets (e.g. java's JAVA_HOME, platform's
# TOOLSPATH/KERNELNAME) instead of functions it defines. _mbe_deactivateModules
# reads this to unset exactly the variables a module actually set, instead of
# leaving them stale forever after deactivation.
#
# Two different diff windows are needed, since variables get set in two
# different places with different call semantics:
#  - _load-time vars are captured in the same before/after window
#    _mbe_activateModules already uses for functions, and have the exact same
#    recursion risk (a dependency's _load-time vars would otherwise be
#    misattributed to the module that pulled it in) -- so this reuses
#    _MBE_ACTIVATE_DEPTH and a parallel claimed-set, _MBE_CLAIMED_VARS.
#  - _setpath-time vars are captured inside _mbe_buildpath's loop over
#    MODULES_ACTIVE, one before/after snapshot per module's _setpath call.
#    This loop is NOT recursive (no module's _setpath calls _mbe_buildpath or
#    _mbe_activateModules), so no claimed-set/depth-guard is needed there --
#    a flat per-module diff is sufficient.
#
# Attribution is by VALUE CHANGE, not just a variable's name appearing: a
# module only claims a variable if its value differs after the module's
# window vs. before. This is what correctly excludes a module that merely
# re-exports (no reassignment) a variable a dependency already set -- no
# special-case logic needed, the value comparison handles it for free.
#
# PATH/LD_LIBRARY_PATH/MANPATH/INCLUDE are deliberately excluded from both
# windows: _mbe_buildpath already resets these from ORIG_* on every rebuild,
# so tracking them here would be pure noise and could fight with that reset.
if ! declare -p MBE_MODULE_VARS >/dev/null 2>&1; then
	declare -gA MBE_MODULE_VARS
fi
if ! declare -p _MBE_CLAIMED_VARS >/dev/null 2>&1; then
	declare -gA _MBE_CLAIMED_VARS
fi

_mbe_load ()
{
	local module="mbe"
	# Load preferences file
	source "${MODULES_DIR}/${module}/${module}.conf"
	# Load the features specified in preferences file
	for feature in "${__mbe_features[@]}"; do
		source "${MODULES_DIR}/${module}/${feature}"
		"_${module}_${feature}_load"
	done

	export MBE_LOGFILE_NAME="${MBE_LOGFILE_NAME-mbe.log}"
	export MBE_LOGFILE="${MBE_DIR}/${MBE_LOGFILE_NAME}"
	return
}

_mbe_unload ()
{
	return 1
}

_mbe_setpath ()
{
	local module="mbe"
}

_mbe_usage ()
{
	echo "Modular Bash Environment (MBE)"
	echo "MBE provides a framework for loading and unloading coherent sets of functions and"
	echo "environment variables at run-time. Using the MBE system typically involves the"
	echo "addition of a handful of lines to the .bashrc file source during an interactive login."
	echo "Common Functions"
	echo " _mbe_activateModules <module1> <module2>... - Activates one or more modules in the current environment"
	echo " _mbe_activateAllModules <module1> <module2>... - Activates all available modules in the current environment"
	echo " _mbe_deactivateModules <module1> <modoule2>... - Deactivates one or more modules in the current environment"
	echo " _mbe_reactivateModule <module> - Refreshes the specified module"
	echo " _mbe_listActiveModules - Lists the active modules in the current environment"
	echo " _mbe_listInactiveModules - Lists the inactive modules in the current environment"
	echo " _mbe_listAllModules - Lists all modules in the environment"
}

############################################################
# debug
# Description:
#  Adds the 'DEBUG' function, used to enable conditional
#  execution of the code following 'DEBUG'.
############################################################
#_DEBUG="on"
DEBUG ()
{
   [ "$_DEBUG" == "on" ] &&  "$*" || :
}

############################################################
# mbe
# Description:
#  Adds the 'mbe' function.
############################################################
mbe ()
{
	if [ $# -eq 0 ]; then
		_mbe_usage
		return
	elif [ "$1" == "deactivate" ]; then
		# deactivate <module name>... [-y] -- accepts any number of module
		# names plus an optional -y (skip the dependent-cascade confirmation
		# prompt), so this is checked before the fixed-arg-count dispatch
		# below rather than assuming exactly 2 args.
		shift
		_mbe_deactivateModules "$@"
		return
	elif [ $# -eq 1 ]; then
		# no-argument commands are:
		# list
		if [ "$1" == "list" ]; then
			_mbe_listActiveModules
			return
		fi
	elif [ $# -eq 2 ]; then
		# commands are:
		# activate <module name>
		if [ "$1" == "activate" ]; then
			_mbe_activateModules "$2"
			return
		elif [ "$1" == "list" ]; then
			_mbe_list "$2"
			return
		else
			local module_name=$1
			local module_command=$2
			command="_${module_name}_${module_command}"
			${command}
		fi
	else
		local module_name=$1
		local module_command=$2
		command="_${module_name}_${module_command}"
		shift
		shift
		"${command}" "$@"
	fi
}

