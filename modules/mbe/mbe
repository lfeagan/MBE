_mbe_activateModules ()
{
	# Loads one or more modules into mbe
	if (( $# < 1 )); then
		echo "ERROR: Must provide at least 1 argument to _mbe_activateModules"
		return 1
	fi
	(( _MBE_ACTIVATE_DEPTH++ ))
	(( _MBE_ACTIVATE_DEPTH == 1 )) && _MBE_CLAIMED_FUNCS=()

	local newmodule newmodules
	newmodules=( "$@" )

	for newmodule in "${newmodules[@]}"; do
		_mbe_isModuleActive "$newmodule"
		if [ "$?" == "1" ]; then
			# Module is already active
			continue
		else
			# Module is not yet active
			DEBUG echo "_mbe_activateModule: activating $newmodule"
			if [ -n "$MODULES_DIR" ]; then
				DEBUG echo -e "_mbe_activateModules: source \"${MODULES_DIR}/${newmodule}/${newmodule}\""
				local before after
				before="$(declare -F | awk '{print $3}')"
				# compgen -e (exported vars only) rather than -v: bash's
				# `local` scoping is dynamic, so -v would also pick up every
				# local variable on the current call stack (this function's
				# own scaffolding, and any locals in whatever called us) --
				# none of that is module-owned state. Every real var a
				# module sets (JAVA_HOME, TOOLSPATH, etc.) is exported.
				local -A varbefore=( )
				local v
				for v in $(compgen -e); do varbefore[$v]="${!v}"; done
				source "${MODULES_DIR}/${newmodule}/${newmodule}"
				"_${newmodule}_load"

				# Diff declare -F before/after to discover exactly which functions this
				# module (not a nested dependency it may have activated) just defined --
				# see MBE_MODULE_FUNCS comment near the top of this file.
				local -A beforeset=( ) ownfuncs=( )
				local f
				for f in $before; do beforeset[$f]=1; done
				after="$(declare -F | awk '{print $3}')"
				for f in $after; do
					if [[ -z "${beforeset[$f]}" && -z "${_MBE_CLAIMED_FUNCS[$f]}" ]]; then
						ownfuncs[$f]=1
					fi
				done
				MBE_MODULE_FUNCS[${newmodule}]="${!ownfuncs[*]}"
				for f in "${!ownfuncs[@]}"; do _MBE_CLAIMED_FUNCS[$f]=1; done

				# Same idea for variables -- see MBE_MODULE_VARS comment near
				# the top of this file. A module claims a var only if its
				# value changed (covers newly-set AND reassigned), not merely
				# because the name is present -- this is what correctly
				# excludes a module that only re-exports (no reassignment) a
				# variable a dependency already set.
				local -A ownvars=( )
				for v in $(compgen -e); do
					case "$v" in
						PATH|LD_LIBRARY_PATH|MANPATH|INCLUDE) continue ;;
					esac
					if [[ "${varbefore[$v]+set}" != "set" || "${varbefore[$v]}" != "${!v}" ]] \
						&& [[ -z "${_MBE_CLAIMED_VARS[$v]}" ]]; then
						ownvars[$v]=1
					fi
				done
				MBE_MODULE_VARS[${newmodule}]="${!ownvars[*]}"
				for v in "${!ownvars[@]}"; do _MBE_CLAIMED_VARS[$v]=1; done

				MODULES_ACTIVE=( "${MODULES_ACTIVE[@]}" "${newmodule}" )
				MODULES_ACTIVE_SET[${newmodule}]=1
			fi
		fi
	done

	(( _MBE_ACTIVATE_DEPTH-- ))
	if (( _MBE_ACTIVATE_DEPTH == 0 )); then
		_MBE_CLAIMED_FUNCS=()
		_MBE_CLAIMED_VARS=()
		# Only rebuild the path once, when unwinding back to the top of one
		# _mbe_activateModules call tree -- not on every nested return.
		# Besides being redundant work, calling _mbe_buildpath from a nested
		# frame runs every active module's _setpath (including ones this
		# call tree hasn't finished activating yet) before an enclosing
		# frame's own "after" var-diff snapshot is taken, which would
		# misattribute _setpath-time vars (e.g. platform's TOOLSPATH) to
		# whichever outer module happened to still be inside its _load.
		_mbe_buildpath
	fi
	return
}

_mbe_findDependents ()
{
	# Given one or more module names, prints (one per line) every OTHER
	# currently-active module that transitively depends on any of them --
	# i.e. what would be left active-but-broken if the named modules were
	# deactivated without also deactivating their dependents.
	local targets=( "$@" )
	local -A targetset=( )
	local t
	for t in "${targets[@]}"; do targetset[$t]=1; done

	# Repeat until a full pass adds nothing new, so transitive dependents
	# (X depends on maven, maven depends on java -- deactivating java must
	# also catch X) are found, not just direct ones.
	local changed=1
	while (( changed == 1 )); do
		changed=0
		local activemodule
		for activemodule in "${MODULES_ACTIVE[@]}"; do
			[ -n "${targetset[$activemodule]}" ] && continue
			local depsvar="__${activemodule}_dependencies[@]"
			local dep
			for dep in "${!depsvar}"; do
				if [ -n "${targetset[$dep]}" ]; then
					targetset[$activemodule]=1
					changed=1
					break
				fi
			done
		done
	done

	for t in "${targets[@]}"; do unset "targetset[$t]"; done
	local result
	for result in "${!targetset[@]}"; do
		echo "${result}"
	done
}

_mbe_deactivateModules ()
{
	# Unloads one or more modules from mbe. Accepts an optional -y anywhere
	# in the argument list to assume "yes" and skip the dependent-cascade
	# confirmation prompt below (for scripting/non-interactive use).
	local oldmodule oldmodules
	oldmodules=( )
	local assumeyes=0
	for oldmodule in "$@"; do
		if [ "${oldmodule}" == "-y" ]; then
			assumeyes=1
		else
			oldmodules+=( "${oldmodule}" )
		fi
	done

	if (( ${#oldmodules[@]} < 1 )); then
		echo "ERROR: Must provide at least 1 module argument to _mbe_deactivateModules"
		return 1
	fi

	local dependents
	mapfile -t dependents < <(_mbe_findDependents "${oldmodules[@]}")
	if (( ${#dependents[@]} > 0 )); then
		echo "The following active modules depend on what you're deactivating and will also be deactivated:"
		local d
		for d in "${dependents[@]}"; do
			echo "  ${d}"
		done
		if (( assumeyes == 1 )); then
			oldmodules+=( "${dependents[@]}" )
		else
			local validInput=0
			local confirmation
			while (( validInput == 0 )); do
				echo -n "Proceed? [y/n] and press [ENTER]: "
				read -r confirmation
				case "${confirmation}" in
					y*|Y*)
						validInput=1
						oldmodules+=( "${dependents[@]}" )
						;;
					n*|N*)
						echo "Aborted -- nothing was deactivated."
						return 1
						;;
				esac
			done
		fi
	fi

	for oldmodule in "${oldmodules[@]}"; do
		_mbe_isModuleActive "$oldmodule"
		if [ "$?" == "0" ]; then
			# Module is already active
			continue
		else
			# Module is not yet active
			DEBUG echo "_mbe_deactivateModules: unloading $oldmodule"
			"_${oldmodule}_unload"

			# Unset exactly the functions this module defined, per the
			# declare -F diff _mbe_activateModules recorded -- see
			# MBE_MODULE_FUNCS comment near the top of this file. Any
			# non-function cleanup (aliases, etc.) is still the module's own
			# _unload's responsibility, called above.
			local f
			for f in ${MBE_MODULE_FUNCS[${oldmodule}]}; do
				unset -f "${f}"
			done
			unset "MBE_MODULE_FUNCS[${oldmodule}]"

			# Same idea for the variables this module set -- see
			# MBE_MODULE_VARS comment near the top of this file.
			local v
			for v in ${MBE_MODULE_VARS[${oldmodule}]}; do
				unset "${v}"
			done
			unset "MBE_MODULE_VARS[${oldmodule}]"

			unset "MODULES_ACTIVE_SET[${oldmodule}]"
			local remaining=( )
			local activemodule
			for activemodule in "${MODULES_ACTIVE[@]}"; do
				[ "${activemodule}" == "${oldmodule}" ] || remaining+=("${activemodule}")
			done
			MODULES_ACTIVE=( "${remaining[@]}" )
		fi
	done
	_mbe_buildpath
	return
}

_mbe_reactivateModules ()
{
	# Reloads one or more modules from mbe
	if (( $# < 1 )); then
		echo "ERROR: Must provide at least 1 argument to _mbe_reactivateModules"
		return 1
	fi
	_mbe_deactivateModules "$*"
	_mbe_activateModules "$*"
	return
}

_mbe_activateAllModules ()
{
	local modules
	mapfile -t modules < <(_mbe_listAllModules)
	_mbe_activateModules "${modules[@]}"
}

_mbe_isModuleActive ()
{
	# $1 is the name of the module to check
	if [ -z "$1" ]; then
		echo "ERROR: Must provide at least one argument"
		return 1
	fi

	if [ -n "${MODULES_ACTIVE_SET[$1]}" ]; then
		return 1
	fi
	return 0
}

_mbe_list ()
{
	if [ -z "$1" ]; then
		echo "Must specify all, active, or inactive"
		return 1
	fi

	case "$1" in
	active)
		_mbe_listActiveModules
		;;
	all)
		_mbe_listAllModules
		;;
	inactive)
		_mbe_listInactiveModules
		;;
	esac
}

_mbe_listActiveModules ()
{
	local module
	if [[ $1 == -1 ]]; then
		for module in "${MODULES_ACTIVE[@]}"; do
			echo "${module}"
		done
	else
		echo "${MODULES_ACTIVE[@]}"
	fi
}

_mbe_listAllModules ()
{
	# Lists all available modules.
	# With no arguments looks at user's modules directory
	# Takes an optional '-a' argument to specify use of the archive.

	if [ -n "$MODULES_DIR" ]; then
		#pushd "$MODULES_DIR" > /dev/null
		#read -r -a modules <<< $(ls -1 ${MODULES_DIR})
		modules=( "${MODULES_DIR}"/* )
		local module
		local result=()
		for module in "${modules[@]}"; do
			module="${module##/*/}"
			result+=( "${module}" )
			#echo -e "$module "
		done

		if [[ $1 == -1 ]]; then
			for module in "${result[@]}"; do
				echo "${module}"
			done
		else
			echo "${result[@]}"
		fi
	fi
}

_mbe_listInactiveModules ()
{
	local module
	local result=()
	for module in $(_mbe_listAllModules); do
		_mbe_isModuleActive "${module}"
		if [ $? -eq 0 ]; then
			result+=( "${module}" )
		fi
	done

	if [[ $1 == -1 ]]; then
		for module in "${result[@]}"; do
			echo "${module}"
		done
	else
		echo "${result[@]}"
	fi
}

_mbe_getModulePath ()
{
	# $1 is the name of the module to get the path for
	if [ -z "$1" ]; then
		echo "ERROR: Must provide one argument, the module to be edited"
		return 1
	fi

	local module="${1}"
	echo "${MODULES_DIR}/${module}"
}

_mbe_editModule ()
{
	# $1 is the name of the module to be edited
	if [ -z "$1" ]; then
		echo "ERROR: Must provide one argument, the module to be edited"
		return 1
	fi

	local module="${1}"
	local modulepath="${MODULES_DIR}/${module}/${module}"

	if [ ! -f "${modulepath}" ]; then
		echo -e "ERROR: Cannot find module ${module} at \"${modulepath}\""
		return 1
	else
		if [ ! -w "${modulepath}" ]; then
			echo -e "ERROR: Cannot write to module ${module} at \"${modulepath}\""
			return 1	
		fi
	fi


	${EDITOR} "${modulepath}"
}

